#!/bin/sh
name=$(basename "$0")
sysv() { exec "/usr/local/libexec/schema-init/sysv/$name" "$@"; }
[ "$(cat /proc/1/comm 2>/dev/null)" = schema-init ] || sysv "$@"

action=poweroff
[ "$name" = reboot ] && action=reboot
for a in "$@"; do
    case "$a" in
        -w|--wtmp-only|--help) sysv "$@" ;;
        -c|-k) echo "shutdown $a: not supported under schema-init" >&2; exit 1 ;;
        -r|--reboot) action=reboot ;;
        -h|-H|-P|--halt|--poweroff|now|-f|--force|-n|-d|-i|-p|-t*) ;;
        *)
            if [ "$name" = shutdown ]; then
                echo "shutdown $a: only 'now' is supported under schema-init" >&2; exit 1
            fi ;;
    esac
done
exec /usr/bin/schema-ctl "$action"
