#!/bin/sh
exec >> /var/log/sddm-schema.log 2>&1
set -x
mkdir -p /run/user/1000
chown 1000:1000 /run/user/1000
chmod 700 /run/user/1000
udevadm trigger --subsystem-match=input --action=add
udevadm settle --timeout=10
stty -F /dev/tty1 -echo 2>/dev/null || true
timeout 5 plymouth --wait quit 2>/dev/null || plymouth quit 2>/dev/null || true
stty -F /dev/tty1 -echo 2>/dev/null || true
perl -e 'use POSIX; open(my $fh, "+<", "/dev/tty1") or die; tcflush(fileno($fh), 0);'
clear > /dev/tty1

while true; do
    rm -f /run/user/1000/wayland-* /tmp/.ICE-unix/* /tmp/.X*-lock 2>/dev/null || true
    runuser -u ajax80 -- env \
        XDG_RUNTIME_DIR=/run/user/1000 \
        LANG=en_US.UTF-8 \
        PLASMA_USE_SYSTEMD_SCOPE=0 \
        XDG_CURRENT_DESKTOP=KDE \
        XDG_SESSION_TYPE=wayland \
        XDG_SESSION_CLASS=user \
        XDG_SESSION_DESKTOP=KDE \
        XDG_SEAT=seat0 \
        XDG_VTNR=1 \
        DESKTOP_SESSION=plasma \
        KDE_FULL_SESSION=true \
        KDE_SESSION_VERSION=6 \
        KDE_SESSION_UID=1000 \
        /usr/libexec/plasma-dbus-run-session-if-needed /usr/local/bin/plasma-session-start.sh
    RC=$?
    printf 'plasma_exited rc=%d\n' $RC
    [ $RC -ne 0 ] && break
    sleep 2
done
