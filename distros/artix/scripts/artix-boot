#!/bin/sh
PATH=/usr/bin
L=/usr/local/libexec/schema-init
[ -s /etc/hostname ] && cat /etc/hostname > /proc/sys/kernel/hostname
ip link set up dev lo
kmod static-nodes --format=tmpfiles --output=/run/tmpfiles.d/kmod.conf
etmpfiles --prefix=/dev --create --boot
{
    sed -nr 's/,/\n/;s/(.* |^)(rd\.)?modules-load=([^ ]*).*/\3/p' /proc/cmdline
    for f in /etc/modules-load.d/*.conf /run/modules-load.d/*.conf /usr/lib/modules-load.d/*.conf; do
        [ -f "$f" ] && grep -hv -e '^[#;]' -e '^$' "$f"
    done
} | xargs -r modprobe -ab
HARDWARECLOCK=UTC
[ -r /etc/hwclock.conf ] && . /etc/hwclock.conf
case $HARDWARECLOCK in
    localtime) hwclock --systz --localtime --noadjfile ;;
    *) hwclock --systz --utc --noadjfile ;;
esac
etmpfiles --exclude-prefix=/dev --create --remove --boot
install -m0664 -o root -g utmp /dev/null /run/utmp
[ -e /var/log/wtmp ] || install -m0664 -o root -g utmp /dev/null /var/log/wtmp
[ -e /var/log/btmp ] || install -m0600 -o root -g utmp /dev/null /var/log/btmp
rm -f /etc/nologin /run/nologin /forcefsck /fastboot
dbus-uuidgen --ensure=/etc/machine-id
ssh-keygen -A >/dev/null 2>&1
mkdir -p -m 0755 /run/dbus
for n in halt poweroff reboot shutdown; do
    [ -f /usr/bin/$n ] && [ ! -L /usr/bin/$n ] && ! findmnt -rn /usr/bin/$n >/dev/null &&
        mount --bind $L/artix-halt /usr/bin/$n
done
exit 0
