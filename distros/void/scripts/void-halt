#!/bin/sh
name=$(basename "$0")
runit() { exec "/usr/bin/$name" "$@"; }
[ "$(cat /proc/1/comm 2>/dev/null)" = schema-init ] || runit "$@"

action=poweroff
[ "$name" = reboot ] && action=reboot
for a in "$@"; do
    case "$a" in
        -B|-w|--help) runit "$@" ;;
        -c|-k) echo "shutdown $a: not supported under schema-init" >&2; exit 1 ;;
        -r) action=reboot ;;
        -h|-P|-p|-f|-d|now|+0) ;;
        *)
            if [ "$name" = shutdown ]; then
                echo "shutdown $a: only 'now' is supported under schema-init" >&2; exit 1
            fi ;;
    esac
done
exec /usr/bin/schema-ctl "$action"
