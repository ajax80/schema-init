#!/bin/sh
set -e

case "$1" in
remove)
    # init= would point at a deleted wrapper and the next boot would panic; never fail the removal over it
    # with /boot/firmware unmounted, status sees no cmdline.txt and says not enabled
    "${SCHEMA_PI_MOUNT_FIRMWARE:-/usr/libexec/schema-init/schema-pi-mount-firmware}" 2>/dev/null || true
    if schema-pi status 2>/dev/null | grep -qx 'enabled: yes'; then
        schema-pi disable || true
    fi
    # give systemd-sysv its reboot/poweroff/halt/shutdown back (postinst, #488)
    sbin=${SCHEMA_SBIN:-/usr/sbin}
    for f in reboot poweroff halt shutdown; do
        [ "$(readlink "$sbin/$f" 2>/dev/null)" = /usr/libexec/schema-init/schema-pi-halt ] || continue
        rm -f "$sbin/$f"
        dpkg-divert --package schema-init --rename --remove "$sbin/$f" > /dev/null || true
    done
    ;;
esac

#DEBHELPER#

exit 0
