#!/bin/sh
# No RTC, and systemd-timesyncd is reclaimed by the importer: take the time from an HTTP Date header by IP, so the clock needs no DNS (unbound's DNSSEC needs a sane clock first).
CURL=${SCHEMA_PI_CURL:-curl}
DATE=${SCHEMA_PI_DATE:-date}
# baked from SOURCE_DATE_EPOCH by debian/rules; empty in an unbuilt copy, which uses its own mtime
BUILD_EPOCH=

# The Date header is unauthenticated, so never take a time from before this package was built.
# A step back from the running clock needs both sources to agree within 60 s: one spoofed
# answer can move the clock forward from boot, but cannot wind it back.
floor() {
    b=${BUILD_EPOCH:-$(stat -c %Y "$0" 2>/dev/null)}
    echo "${b:-0}"
}

ask() {
    $CURL -sI --max-time 10 "http://$1/" | awk -F': ' 'tolower($1) == "date" { print $2 }' | tr -d '\r'
}

while :; do
    until [ -n "$(ip route show default 2>/dev/null)" ]; do sleep 2; done
    ok= d1=$(ask 1.1.1.1) d2=$(ask 8.8.8.8)
    t1=$([ -n "$d1" ] && $DATE -d "$d1" +%s 2>/dev/null)
    t2=$([ -n "$d2" ] && $DATE -d "$d2" +%s 2>/dev/null)
    f=$(floor) now=$($DATE +%s)
    for pick in 1 2; do
        if [ $pick = 1 ]; then d=$d1 t=$t1 o=$t2 addr=1.1.1.1; else d=$d2 t=$t2 o=$t1 addr=8.8.8.8; fi
        [ -n "$d" ] || continue
        # an answer is no outage: a refused time waits for the resync, not the 30 s retry
        ok=${ok:-0}
        if [ -z "$t" ] || [ "$t" -lt "$f" ]; then
            echo "timesync: ignored $d from $addr (before build $f)"
            continue
        fi
        if [ "$t" -lt "${now:-0}" ]; then
            dd=$((t - ${o:-0})); [ "$dd" -lt 0 ] && dd=$((-dd))
            if [ -z "$o" ] || [ "$dd" -gt 60 ]; then
                echo "timesync: ignored $d from $addr (behind the clock, second source does not agree)"
                continue
            fi
        fi
        if $DATE -s "$d" >/dev/null; then
            echo "timesync: $d from $addr"
            ok=1
            break
        fi
    done
    if [ -n "$ok" ]; then
        sleep "${SCHEMA_PI_RESYNC:-21600}"
    else
        echo "timesync: no time source reached"
        sleep "${SCHEMA_PI_RETRY:-30}"
    fi
    [ -z "${SCHEMA_PI_ONCE:-}" ] || exit 0
done
