#!/bin/sh
R=${SCHEMA_PI_ROOT:-}
CL=$R/boot/firmware/cmdline.txt
BAK=$CL.schema-bak
D=$R/var/lib/schema-init
KG=$D/known-good
SVC=$R/etc/schema-init/services
SHARE=$R/usr/share/schema-init
REQ=$R/etc/schema-init/pi-boot-required
SUMS=$D/kit.sums
KIT="pi-early udev udev-trigger dbus pi-mounts pi-timesync journal-sink pi-boot-firmware pi-bootok pi-deadline"
NETS="NetworkManager systemd-networkd networking dhcpcd wpa_supplicant"
ARG=init=/usr/sbin/schema-init-pi
IMPORT=${SCHEMA_IMPORT:-/usr/libexec/schema-init/schema-import}
MAX_DEPS=8
BL=$(printf ' \t')

usage() {
    echo "usage: schema-pi enable|disable|status|refresh" >&2
    exit 2
}

die() {
    echo "schema-pi: $*" >&2
    exit 1
}

# first line only, CRs stripped: the firmware reads one line
firstline() { sed -n 1p "$CL" | tr -d '\r'; }

# drops each init= token plus the one separator before it, touching nothing else
strip_init() {
    sed -e ':a' \
        -e 's/^init=[^[:blank:]]*[[:blank:]]*//' \
        -e 's/[[:blank:]]init=[^[:blank:]]*//' \
        -e 'ta'
}

# FAT /boot: tmp in the same dir then mv, no permission games
write_cmdline() {
    tmp=$CL.tmp.$$
    printf '%s\n' "$1" > "$tmp" || die "cannot write $tmp"
    sync
    mv "$tmp" "$CL" || die "cannot replace $CL"
    sync
}

# schema-init has no fstab automount: an unmounted /boot/firmware would hide the real cmdline.txt
mount_firmware() {
    awk '$1 !~ /^#/ && $2 == "/boot/firmware" { f = 1 } END { exit !f }' "$R/etc/fstab" 2>/dev/null || return 0
    mountpoint -q "$R/boot/firmware" || mount "$R/boot/firmware" || die "cannot mount /boot/firmware"
}

need_root() {
    [ -n "${SCHEMA_PI_ROOT:-}" ] && return 0
    [ "$(id -u)" = 0 ] || die "must run as root"
}

# $1: services dir; $2: scratch dir for a trial run (bus overrides and state go there too).
# stdout kept in $out for owner lookups; stderr passes through
run_import() {
    out=$(
        d=$1
        if [ -n "${2:-}" ]; then
            export SCHEMA_BUS_OVERRIDE_DIR="$2/bus" SCHEMA_STATE_DIR="$2/state"
        fi
        # --enabled drops every systemd-* unit as reclaimed; an explicit unit bypasses that filter
        case $net in
            systemd-*) set -- "$net.service" ;;
            *) set -- ;;
        esac
        MIGRATE_ROOT=$R SCHEMA_SVC_DIR=$d "$IMPORT" --enabled "$@"
    )
    sum=$(printf '%s\n' "$out" | sed -n 's/^imported=\([0-9]*\) .* skipped=\([0-9]*\) .*/\1, skipped \2/p' | tail -n 1)
    [ -n "$sum" ] || die "schema-import failed"
}

report_import() {
    echo "schema-pi: imported $sum"
    printf '%s\n' "$out" | sed -n 's/^skip  *\([^ :]*\): \(.*\) (see [^)]*)$/skip \1: \2/p'
    # the importer leaves no marker in a plain file, so enable keeps its own list for the next run's hand-set check
    { cat "$D/pi-imported" 2>/dev/null; printf '%s\n' "$out" | sed -n 's|^import .* -> .*/\([^/]*\)\.svc$|\1|p'; } | sort -u > "$D/pi-imported.tmp" &&
        mv "$D/pi-imported.tmp" "$D/pi-imported"
    # not fatal to enable, but must not vanish
    printf '%s\n' "$out" | grep -e '^ERROR' -e '^WARN' >&2
    # --enabled drops these as reclaimed; named, or a missing timesyncd looks like an import bug
    rn=$(for w in "$R"/etc/systemd/system/*.target.wants/systemd-*; do
            [ -L "$w" ] || [ -e "$w" ] || continue
            n=${w##*/}
            [ "$n" = "$net.service" ] && continue
            case $n in *@*) ;; *.service | *.socket | *.timer) echo "$n" ;; esac
        done | sort -u | awk '{ printf "%s%s", sep, $0; sep = ", " }')
    [ -z "$rn" ] || echo "schema-pi: not imported (schema-init replaces): $rn"
    return 0
}

# an existing .svc is the user's: install only what is absent
install_kit() {
    for s in $KIT; do
        [ -e "$1/$s.svc" ] || cp "$SHARE/$s.svc.example" "$1/$s.svc" || die "cannot install $s.svc"
    done
}

kit_sum() { sha256sum < "$1" | cut -d' ' -f1; }
recorded() { sed -n "s/^\([0-9a-f]*\)  $1\$/\1/p" "$SUMS" 2>/dev/null; }

# sha256 of each kit .svc as schema-pi last wrote it, so refresh can tell an
# untouched file from an edited one. A file identical to its example is
# (re)recorded; any other keeps its old record, or stays unrecorded.
record_kit() {
    for s in $KIT; do
        f=$SVC/$s.svc
        if [ -f "$f" ] && cmp -s "$f" "$SHARE/$s.svc.example"; then
            echo "$(kit_sum "$f")  $s"
        else
            r=$(recorded "$s")
            [ -z "$r" ] || echo "$r  $s"
        fi
    done > "$SUMS.tmp" && mv "$SUMS.tmp" "$SUMS" || die "cannot write $SUMS"
}

# package upgrade: shipped kit changes reach an enabled Pi, edits never get overwritten
refresh() {
    need_root
    mount_firmware
    status_enabled || return 0
    new=
    for s in $KIT; do
        f=$SVC/$s.svc
        ex=$SHARE/$s.svc.example
        [ -f "$ex" ] || continue
        cmp -s "$f" "$ex" 2>/dev/null && continue
        if [ -e "$f" ]; then
            r=$(recorded "$s")
            if [ -z "$r" ] || [ "$r" != "$(kit_sum "$f")" ]; then
                echo "schema-pi: $s.svc was edited; kept (shipped version: $ex)"
                continue
            fi
        fi
        cp "$ex" "$f.tmp.$$" && mv "$f.tmp.$$" "$f" || die "cannot replace $f"
        new="$new $s"
    done
    record_kit
    [ -z "$new" ] || echo "schema-pi: refreshed:$new; takes effect on next boot"
}

# a .svc that is neither kit nor something an earlier enable imported was written by hand
warn_hand() {
    hand=
    for f in "$SVC"/*.svc; do
        [ -f "$f" ] || continue
        n=${f##*/}; n=${n%.svc}
        [ -f "$SHARE/$n.svc.example" ] && continue
        grep -qxF "$n" "$D/pi-imported" 2>/dev/null && continue
        hand="$hand${hand:+, }$n"
    done
    [ -z "$hand" ] ||
        echo "schema-pi: warning: hand-written services found: $hand. If they run the same daemons as systemd's units (NetworkManager, sshd, ...) remove them first, or you'll get duplicates." >&2
}

# links dangle under a fake root (they point at /lib, not $R/lib), hence -L
enabled() {
    for w in "$R"/etc/systemd/system/*.wants/"$1".service; do
        if [ -L "$w" ] || [ -e "$w" ]; then return 0; fi
    done
    return 1
}

unit_exists() {
    for d in etc/systemd/system run/systemd/system usr/lib/systemd/system lib/systemd/system; do
        if [ -L "$R/$d/$1.service" ] || [ -e "$R/$d/$1.service" ]; then return 0; fi
    done
    return 1
}

detect_net() {
    for n in $NETS; do
        if enabled "$n"; then echo "$n"; return 0; fi
    done
    return 1
}

# the .svc in dir $1 that runs $2: its own, or the hand set the importer found already running its binary
resolve() {
    if [ -f "$1/$2.svc" ]; then echo "$2"; return 0; fi
    o=$(printf '%s\n' "$out" | sed -n "s/^skip  *$2\.service: its binary already runs as \([^ ]*\)\.svc .*/\1/p" | head -n 1)
    [ -n "$o" ] && [ -f "$1/$o.svc" ] && echo "$o"
}

# only deps the base lacks: a duplicate dep= still takes one of the engine's 8 slots
dropin_deps() {
    for d in udev-trigger dbus; do
        grep -q "^dep=[[:blank:]]*$d[[:blank:]]*\$" "$1" || echo "dep=$d"
    done
}

# the engine refuses a .svc with more than MAX_DEPS dep= lines: the network service would never start
check_deps() {
    have=$(grep -c '^[[:blank:]]*dep=' "$1/$2.svc")
    add=$(dropin_deps "$1/$2.svc" | grep -c .)
    [ $((have + add)) -le $MAX_DEPS ] ||
        die "$2.svc has $have dep= lines and the pi-kit drop-in adds $add: over the engine limit of $MAX_DEPS"
}

write_dropin() {
    f=$SVC/$1.svc.d/pi-kit.conf
    deps=$(dropin_deps "$SVC/$1.svc")
    if [ -z "$deps" ]; then rm -f "$f"; return 0; fi
    mkdir -p "$SVC/$1.svc.d" || die "cannot create $1.svc.d"
    # the engine ignores a group/other-writable drop-in dir
    chmod 755 "$SVC/$1.svc.d"
    printf '%s\n' "$deps" > "$f" || die "cannot write $f"
}

# merge: hand lines and comments stay, missing generated names are appended;
# a name with no .svc is dropped, since bootok would wait on it forever and the deadline falls back
write_required() {
    tmp=$REQ.tmp.$$
    if [ -f "$REQ" ]; then
        : > "$tmp" || die "cannot write $tmp"
        while IFS= read -r l || [ -n "$l" ]; do
            # CRs stripped, as bootok does: a list edited on another OS must still match names
            l=$(printf '%s' "$l" | tr -d '\r')
            t=$(printf '%s' "$l" | sed 's/^[[:blank:]]*//; s/[[:blank:]]*$//')
            case $t in
                '' | '#'*) ;;
                *) if [ ! -f "$SVC/$t.svc" ]; then
                       echo "schema-pi: dropped $t from pi-boot-required (no .svc)"
                       continue
                   fi ;;
            esac
            printf '%s\n' "$l" >> "$tmp" || die "cannot write $tmp"
        done < "$REQ"
    else
        echo "# written by schema-pi enable; later enables keep hand lines" > "$tmp" || die "cannot write $tmp"
    fi
    gen="udev udev-trigger dbus pi-early $1 $2"
    if [ -f "$SVC/pihole-FTL.svc" ]; then
        gen="$gen pihole-FTL"
        if [ -f "$SVC/unbound.svc" ]; then gen="$gen unbound"; fi
    fi
    for n in $gen; do
        sed 's/^[[:blank:]]*//; s/[[:blank:]]*$//' "$tmp" | grep -qxF "$n" || echo "$n" >> "$tmp" ||
            die "cannot write $tmp"
    done
    mv "$tmp" "$REQ" || die "cannot replace $REQ"
}

enable() {
    need_root
    mount_firmware
    [ -f "$CL" ] || die "$CL not found: not a Raspberry Pi boot layout"
    [ -x "$R/lib/systemd/systemd" ] || die "/lib/systemd/systemd missing: no systemd to fall back to"
    if command -v findmnt > /dev/null 2>&1; then
        opts=$(findmnt -no OPTIONS -T "$R/var/lib" 2>/dev/null)
        case ,$opts, in
            *,noexec,*) die "/var/lib is mounted noexec: known-good copy could not run" ;;
        esac
    fi

    # refused before any write: on a Pi already running schema-init a half enable changes the next boot
    net=$(detect_net) || die "no enabled network service ($NETS): schema-init would boot unreachable"
    unit_exists "$net" || [ -f "$SVC/$net.svc" ] || die "$net is enabled but $net.service not found"
    enabled ssh || enabled sshd || [ -f "$SVC/ssh.svc" ] || [ -f "$SVC/sshd.svc" ] ||
        die "no ssh service enabled: schema-init would boot without ssh"

    warn_hand
    # trial: the same import into a scratch copy, so every refusal below comes before the first write
    S=$(mktemp -d) || die "cannot create a scratch dir"
    trap 'rm -rf "$S"' EXIT
    mkdir "$S/svc" || die "cannot create $S/svc"
    if [ -d "$SVC" ]; then cp -pR "$SVC/." "$S/svc/" || die "cannot copy $SVC"; fi
    install_kit "$S/svc"
    run_import "$S/svc" "$S"
    netsvc=$(resolve "$S/svc" "$net") || die "$net is enabled but $net.svc missing after import"
    check_deps "$S/svc" "$netsvc"
    resolve "$S/svc" ssh > /dev/null || resolve "$S/svc" sshd > /dev/null ||
        die "no ssh service after import: schema-init would boot without ssh"

    mkdir -p "$SVC" "$D"
    install_kit "$SVC"
    record_kit
    run_import "$SVC"
    report_import

    # backstops: the trial saw the same root, but the importer may still decide otherwise
    netsvc=$(resolve "$SVC" "$net") || die "$net is enabled but $net.svc missing after import"
    check_deps "$SVC" "$netsvc"
    write_dropin "$netsvc"
    ssh=$(resolve "$SVC" ssh) || ssh=$(resolve "$SVC" sshd) ||
        die "no ssh service after import: schema-init would boot without ssh"
    write_required "$ssh" "$netsvc"

    [ -e "$BAK" ] || cp "$CL" "$BAK" || die "cannot write $BAK"

    # re-enable after a fallback must not overwrite the last good set with a possibly broken current
    if [ ! -d "$KG" ]; then
        SCHEMA_PI_ROOT=$R "${SCHEMA_PI_BOOTOK:-/usr/libexec/schema-init/schema-pi-bootok}" --promote ||
            die "known-good seeding failed"
    fi
    status_enabled || printf 'attempts=0\nlast_target=current\n' > "$D/pi-boot"

    line=$(firstline | strip_init)
    # without panic= an early PID 1 crash hangs the kernel for good and the attempt counter never advances
    case " $line" in
        *[$BL]panic=*) ;;
        *) line="$line panic=10" ;;
    esac
    write_cmdline "$line $ARG"
    echo "schema-pi: enabled; takes effect on next boot"
}

disable() {
    need_root
    mount_firmware
    [ -f "$CL" ] || die "$CL not found"
    # panic= stays: rebooting on a kernel panic is harmless under systemd too
    write_cmdline "$(firstline | strip_init)"
    echo "schema-pi: disabled; systemd boots next time (panic= left in cmdline.txt)"
}

status_enabled() {
    [ -f "$CL" ] && firstline | grep -q "\(^\|[$BL]\)$ARG\([$BL]\|\$\)"
}

status() {
    if status_enabled; then
        echo "enabled: yes"
    else
        echo "enabled: no"
    fi
    echo "pid1: $(cat "${SCHEMA_PROC1:-/proc/1/comm}" 2>/dev/null || echo -)"
    a=$(sed -n 's/^attempts=//p' "$D/pi-boot" 2>/dev/null | head -n 1)
    t=$(sed -n 's/^last_target=//p' "$D/pi-boot" 2>/dev/null | head -n 1)
    echo "attempts: ${a:--}"
    echo "last_target: ${t:--}"
    f=$(tail -n 1 "$R/var/log/schema-init/fallback.log" 2>/dev/null)
    echo "last_fallback: ${f:--}"
    v=$("$KG/schema-init" --version 2>/dev/null | head -n 1)
    echo "known_good: ${v:--}"
    # bootok's rule, so status and boot OK cannot disagree on what is up
    n=$(SCHEMA_PI_ROOT=$R "${SCHEMA_PI_BOOTOK:-/usr/libexec/schema-init/schema-pi-bootok}" --blockers --all 2>/dev/null |
        tr '\n' ' ' | sed 's/ *$//')
    [ -z "$n" ] || echo "not up: $n"
}

case ${1:-} in
    enable) enable ;;
    disable) disable ;;
    status) status ;;
    refresh) refresh ;;
    *) usage ;;
esac
