#!/bin/sh
R=${SCHEMA_PI_ROOT:-}
CL=$R/boot/firmware/cmdline.txt
BAK=$CL.schema-bak
D=$R/var/lib/schema-init
KG=$D/known-good
SVC=$R/etc/schema-init/services
SHARE=$R/usr/share/schema-init
REQ=$R/etc/schema-init/pi-boot-required
KIT="pi-early udev udev-trigger dbus pi-timesync journal-sink pi-boot-firmware pi-bootok pi-deadline"
NETS="NetworkManager systemd-networkd networking dhcpcd wpa_supplicant"
ARG=init=/usr/sbin/schema-init-pi
BL=$(printf ' \t')

usage() {
    echo "usage: schema-pi enable|disable|status" >&2
    exit 2
}

die() {
    echo "schema-pi: $*" >&2
    exit 1
}

# first line only, CRs stripped: the firmware reads one line
firstline() { sed -n 1p "$CL" | tr -d '\r'; }

# drops each init= token plus the one separator before it, touching nothing else
strip_init() {
    sed -e ':a' \
        -e 's/^init=[^[:blank:]]*[[:blank:]]*//' \
        -e 's/[[:blank:]]init=[^[:blank:]]*//' \
        -e 'ta'
}

# FAT /boot: tmp in the same dir then mv, no permission games
write_cmdline() {
    tmp=$CL.tmp.$$
    printf '%s\n' "$1" > "$tmp" || die "cannot write $tmp"
    sync
    mv "$tmp" "$CL" || die "cannot replace $CL"
    sync
}

# schema-init has no fstab automount: an unmounted /boot/firmware would hide the real cmdline.txt
mount_firmware() {
    awk '$1 !~ /^#/ && $2 == "/boot/firmware" { f = 1 } END { exit !f }' "$R/etc/fstab" 2>/dev/null || return 0
    mountpoint -q "$R/boot/firmware" || mount "$R/boot/firmware" || die "cannot mount /boot/firmware"
}

need_root() {
    [ -n "${SCHEMA_PI_ROOT:-}" ] && return 0
    [ "$(id -u)" = 0 ] || die "must run as root"
}

# stdout kept in $out for owner lookups; stderr passes through
import_enabled() {
    out=$(MIGRATE_ROOT=$R SCHEMA_SVC_DIR=$SVC "${SCHEMA_IMPORT:-/usr/libexec/schema-init/schema-import}" --enabled "$@")
    sum=$(printf '%s\n' "$out" | sed -n 's/^imported=\([0-9]*\) .* skipped=\([0-9]*\) .*/\1, skipped \2/p' | tail -n 1)
    [ -n "$sum" ] || die "schema-import failed"
    echo "schema-pi: imported $sum"
    printf '%s\n' "$out" | sed -n 's/^skip  *\([^ :]*\): \(.*\) (see [^)]*)$/skip \1: \2/p'
    # not fatal to enable, but must not vanish
    printf '%s\n' "$out" | grep -e '^ERROR' -e '^WARN' >&2
    return 0
}

# links dangle under a fake root (they point at /lib, not $R/lib), hence -L
enabled() {
    for w in "$R"/etc/systemd/system/*.wants/"$1".service; do
        if [ -L "$w" ] || [ -e "$w" ]; then return 0; fi
    done
    return 1
}

unit_exists() {
    for d in etc/systemd/system run/systemd/system usr/lib/systemd/system lib/systemd/system; do
        if [ -L "$R/$d/$1.service" ] || [ -e "$R/$d/$1.service" ]; then return 0; fi
    done
    return 1
}

detect_net() {
    for n in $NETS; do
        if enabled "$n"; then echo "$n"; return 0; fi
    done
    return 1
}

# the .svc that runs $1: its own, or the hand set the importer found already running its binary
resolve() {
    if [ -f "$SVC/$1.svc" ]; then echo "$1"; return 0; fi
    o=$(printf '%s\n' "$out" | sed -n "s/^skip  *$1\.service: its binary already runs as \([^ ]*\)\.svc .*/\1/p" | head -n 1)
    [ -n "$o" ] && [ -f "$SVC/$o.svc" ] && echo "$o"
}

# only deps the base lacks: a duplicate dep= still takes one of the engine's 8 slots
write_dropin() {
    f=$SVC/$1.svc.d/pi-kit.conf
    deps=
    for d in udev-trigger dbus; do
        grep -q "^dep=[[:blank:]]*$d[[:blank:]]*\$" "$SVC/$1.svc" || deps="${deps}dep=$d
"
    done
    if [ -z "$deps" ]; then rm -f "$f"; return 0; fi
    mkdir -p "$SVC/$1.svc.d" || die "cannot create $1.svc.d"
    # the engine ignores a group/other-writable drop-in dir
    chmod 755 "$SVC/$1.svc.d"
    printf '%s' "$deps" > "$f" || die "cannot write $f"
}

# merge: hand lines and comments stay, missing generated names are appended;
# a name with no .svc is dropped, since bootok would wait on it forever and the deadline falls back
write_required() {
    tmp=$REQ.tmp.$$
    if [ -f "$REQ" ]; then
        : > "$tmp" || die "cannot write $tmp"
        while IFS= read -r l || [ -n "$l" ]; do
            t=$(printf '%s' "$l" | sed 's/^[[:blank:]]*//; s/[[:blank:]]*$//')
            case $t in
                '' | '#'*) ;;
                *) if [ ! -f "$SVC/$t.svc" ]; then
                       echo "schema-pi: dropped $t from pi-boot-required (no .svc)"
                       continue
                   fi ;;
            esac
            printf '%s\n' "$l" >> "$tmp" || die "cannot write $tmp"
        done < "$REQ"
    else
        echo "# written by schema-pi enable; later enables keep hand lines" > "$tmp" || die "cannot write $tmp"
    fi
    gen="udev udev-trigger dbus pi-early $1 $2"
    if [ -f "$SVC/pihole-FTL.svc" ]; then
        gen="$gen pihole-FTL"
        if [ -f "$SVC/unbound.svc" ]; then gen="$gen unbound"; fi
    fi
    for n in $gen; do
        sed 's/^[[:blank:]]*//; s/[[:blank:]]*$//' "$tmp" | grep -qxF "$n" || echo "$n" >> "$tmp" ||
            die "cannot write $tmp"
    done
    mv "$tmp" "$REQ" || die "cannot replace $REQ"
}

enable() {
    need_root
    mount_firmware
    [ -f "$CL" ] || die "$CL not found: not a Raspberry Pi boot layout"
    [ -x "$R/lib/systemd/systemd" ] || die "/lib/systemd/systemd missing: no systemd to fall back to"
    if command -v findmnt > /dev/null 2>&1; then
        opts=$(findmnt -no OPTIONS -T "$R/var/lib" 2>/dev/null)
        case ,$opts, in
            *,noexec,*) die "/var/lib is mounted noexec: known-good copy could not run" ;;
        esac
    fi

    # refused before any write: on a Pi already running schema-init a half enable changes the next boot
    net=$(detect_net) || die "no enabled network service ($NETS): schema-init would boot unreachable"
    unit_exists "$net" || [ -f "$SVC/$net.svc" ] || die "$net is enabled but $net.service not found"
    enabled ssh || enabled sshd || [ -f "$SVC/ssh.svc" ] || [ -f "$SVC/sshd.svc" ] ||
        die "no ssh service enabled: schema-init would boot without ssh"

    mkdir -p "$SVC" "$D"
    # an existing .svc is the user's: install only what is absent
    for s in $KIT; do
        [ -e "$SVC/$s.svc" ] || cp "$SHARE/$s.svc.example" "$SVC/$s.svc" || die "cannot install $s.svc"
    done
    # --enabled drops every systemd-* unit as reclaimed; an explicit unit bypasses that filter
    case $net in
        systemd-*) import_enabled "$net.service" ;;
        *) import_enabled ;;
    esac

    # backstops: the importer may still have declined them
    netsvc=$(resolve "$net") || die "$net is enabled but $net.svc missing after import"
    write_dropin "$netsvc"
    ssh=$(resolve ssh) || ssh=$(resolve sshd) ||
        die "no ssh service after import: schema-init would boot without ssh"
    write_required "$ssh" "$netsvc"

    [ -e "$BAK" ] || cp "$CL" "$BAK" || die "cannot write $BAK"

    # re-enable after a fallback must not overwrite the last good set with a possibly broken current
    if [ ! -d "$KG" ]; then
        SCHEMA_PI_ROOT=$R "${SCHEMA_PI_BOOTOK:-/usr/libexec/schema-init/schema-pi-bootok}" --promote ||
            die "known-good seeding failed"
    fi
    status_enabled || printf 'attempts=0\nlast_target=current\n' > "$D/pi-boot"

    line=$(firstline | strip_init)
    # without panic= an early PID 1 crash hangs the kernel for good and the attempt counter never advances
    case " $line" in
        *[$BL]panic=*) ;;
        *) line="$line panic=10" ;;
    esac
    write_cmdline "$line $ARG"
    echo "schema-pi: enabled; takes effect on next boot"
}

disable() {
    need_root
    mount_firmware
    [ -f "$CL" ] || die "$CL not found"
    # panic= stays: rebooting on a kernel panic is harmless under systemd too
    write_cmdline "$(firstline | strip_init)"
    echo "schema-pi: disabled; systemd boots next time (panic= left in cmdline.txt)"
}

status_enabled() {
    [ -f "$CL" ] && firstline | grep -q "\(^\|[$BL]\)$ARG\([$BL]\|\$\)"
}

status() {
    if status_enabled; then
        echo "enabled: yes"
    else
        echo "enabled: no"
    fi
    echo "pid1: $(cat "${SCHEMA_PROC1:-/proc/1/comm}" 2>/dev/null || echo -)"
    a=$(sed -n 's/^attempts=//p' "$D/pi-boot" 2>/dev/null | head -n 1)
    t=$(sed -n 's/^last_target=//p' "$D/pi-boot" 2>/dev/null | head -n 1)
    echo "attempts: ${a:--}"
    echo "last_target: ${t:--}"
    f=$(tail -n 1 "$R/var/log/schema-init/fallback.log" 2>/dev/null)
    echo "last_fallback: ${f:--}"
    v=$("$KG/schema-init" --version 2>/dev/null | head -n 1)
    echo "known_good: ${v:--}"
}

case ${1:-} in
    enable) enable ;;
    disable) disable ;;
    status) status ;;
    *) usage ;;
esac
