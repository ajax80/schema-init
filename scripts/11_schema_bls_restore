#!/usr/bin/sh
# Runs after 10_linux and puts back the schema-init entries its options sync
# clobbered (see 09_schema_bls_save). On an opted-in box (boot-default marker)
# kernel-install twins schema-<kver>.conf are re-cloned from their stock entry
# by 99-schema-init.install itself, so a GRUB_CMDLINE_LINUX change still
# reaches them; every other stashed entry (snapshots, schema-good-*, hand-made,
# twins on a box that never opted in) gets its own options line back verbatim.
# Prints nothing: stdout of a grub.d script lands in grub.cfg.
ENTRIES="${SCHEMA_INIT_GRUB_ENTRIES:-/boot/loader/entries}"
STASH="${SCHEMA_INIT_BLS_STASH:-/run/schema-init-bls-stash}"
HOOK="${SCHEMA_INIT_KI_HOOK:-/usr/lib/kernel/install.d/99-schema-init.install}"
MARKER="${SCHEMA_INIT_CONF_ROOT:-/etc/schema-init}/boot-default"

[ -d "$ENTRIES" ] || exit 0

options_of() {
    sed -n 's/^options //p' "$1" | head -1 | sed 's/[[:space:]]*$//'
}

has_stock() {
    for t in "$ENTRIES"/*-"$1".conf; do
        [ -f "$t" ] || continue
        case "${t##*/}" in
            schema-*|*rescue*) continue ;;
        esac
        return 0
    done
    return 1
}

recloned=
if [ -f "$MARKER" ] && [ -x "$HOOK" ]; then
    KERNEL_INSTALL_BOOT_ROOT="${ENTRIES%/loader/entries}" SCHEMA_INIT_GRUB_ENTRIES="$ENTRIES" \
        "$HOOK" reclone >&2 && recloned=1
fi

[ -d "$STASH" ] || exit 0
for s in "$STASH"/*.conf; do
    [ -f "$s" ] || continue
    e="$ENTRIES/${s##*/}"
    [ -f "$e" ] || continue
    case "${s##*/}" in
        schema-*)
            v="${s##*/schema-}"; v="${v%.conf}"
            [ -n "$recloned" ] && has_stock "$v" && continue
            ;;
    esac
    o="$(options_of "$s")"
    [ "$(options_of "$e")" = "$o" ] && continue
    # via the environment: awk -v would eat backslashes
    OPTS="$o" awk '/^options /{ print "options " ENVIRON["OPTS"]; next } { print }' "$e" > "$e.tmp.$$" &&
        mv "$e.tmp.$$" "$e"
done
rm -rf "$STASH"
exit 0
