#!/bin/sh
# /usr/sbin/{reboot,poweroff,halt,shutdown} on a Pi (#488). systemd-sysv's are
# links to systemctl, which can't reach a systemd that isn't running; the deb
# diverts them to <name>.systemd and links this in their place. Under systemd
# (also the Pi's fallback boot) systemd's own runs, same name and arguments.
name=$(basename "$0")
case "$name" in
    reboot|poweroff|halt|shutdown) ;;
    *) echo "schema-pi-halt: run as reboot, poweroff, halt or shutdown" >&2; exit 2 ;;
esac
systemd() { exec "${SCHEMA_PI_SYSTEMD:-/usr/libexec/schema-init/systemd}/$name" "$@"; }
[ "$(cat "${SCHEMA_PROC1:-/proc/1/comm}" 2>/dev/null)" = schema-init ] || systemd "$@"

refuse() { echo "$name $1: not supported under schema-init (use 'sudo reboot', 'sudo poweroff' or 'sudo shutdown -r now')" >&2; exit 1; }

# same table as the Fedora shim (systemctl_shim.h power_args); nothing is ever
# pending under schema-init, so there's nothing to cancel, wherever -c is
if [ "$name" = shutdown ]; then
    for a in "$@"; do case "$a" in --*) ;; -*c*) exit 0 ;; esac; done
fi
# systemd reads a bare number as minutes: 0 and +00 are now too
time_is_now() {
    [ "$1" = now ] && return 0
    t=${1#+}
    [ -n "$t" ] && [ -z "$(printf %s "$t" | tr -d 0)" ]
}

# schema-ctl has no halt: halt powers off, as the Fedora shim does
action=poweroff
[ "$name" = reboot ] && action=reboot
seen_time=
for a in "$@"; do
    case "$a" in
        # -f: reboot(2) without asking PID 1, the way out when PID 1 is stuck
        --help|--wtmp-only|--force) systemd "$@" ;;
        --reboot) action=reboot ;;
        --poweroff|--halt) action=poweroff ;;
        --no-wall|--no-wtmp) ;;
        --*) refuse "$a" ;;
        -?*)
            flags=${a#-}
            while [ -n "$flags" ]; do
                rest=${flags#?}; c=${flags%"$rest"}; flags=$rest
                case "$c" in
                    w|f) systemd "$@" ;;
                    r) action=reboot ;;
                    p|P|h|H) action=poweroff ;;
                    n|d|i) ;;
                    *) refuse "$a" ;;
                esac
            done ;;
        *)
            [ "$name" = shutdown ] || refuse "$a"
            # the first word is the time; any after it is the wall message, which
            # nobody gets, but the power action itself is the one asked for
            if [ -z "$seen_time" ]; then
                time_is_now "$a" || refuse "$a"
                seen_time=1
            fi ;;
    esac
done
# shutdown with no time means +1 minute; now is only what was asked when it says so
[ "$name" = shutdown ] && [ -z "$seen_time" ] && refuse "without a time (systemd's default is +1 minute)"
exec schema-ctl "$action"
