#!/bin/sh
R=${SCHEMA_PI_ROOT:-}
# run from known-good, the known-good schema-ctl must drive the known-good engine
CTL=schema-ctl
[ -x "${0%/*}/schema-ctl" ] && CTL=${0%/*}/schema-ctl
CTL=${SCHEMA_CTL:-$CTL}
POLL=${SCHEMA_PI_POLL:-5}
D=$R/var/lib/schema-init
STATE=$D/pi-boot
KGP=/var/lib/schema-init/known-good
KG=$R$KGP
MARK=$R/run/schema-init/pi-boot-ok

blockers() {
    "$CTL" status --kv 2>/dev/null | awk -F= '
        $1 ~ /^service\..*\.state$/ {
            n = $1; sub(/^service\./, "", n); sub(/\.state$/, "", n)
            s = $2
            if (n == "pi-bootok" || n == "pi-deadline" || s == "skipped") next
            if (n == "sshd") sshd = 1
            if (s != "FUNDAMENTAL" && s != "PERFECT") print n "=" s
        }
        END { if (!sshd) print "sshd=MISSING" }'
}

now() { date +%s; }

# a power cut between the swap's two mv calls leaves only .old: put the good set back
restore_old() {
    [ ! -d "$KG" ] && [ -d "$KG.old" ] && mv "$KG.old" "$KG"
    return 0
}

# the snapshot's svc files still name /usr/libexec; known-good must run its own copies
point_at_kg() {
    for s in pi-bootok pi-deadline; do
        f=$KG.new/services/$s.svc
        [ -f "$f" ] || continue
        # rewrite in place, not via mv: keeps the file's root ownership the engine requires
        c=$(sed "s|^exec=.*|exec=$KGP/schema-$s|" "$f") && printf '%s\n' "$c" > "$f" || return 1
    done
}

promote() {
    # stale .new from a cut mid-copy would overlay deleted files into the new set
    rm -rf "$KG.new" "$KG.old"
    # a failed copy must not replace a good known-good set
    if mkdir -p "$KG.new/services" &&
        cp -p "$R/usr/bin/schema-init" "$R/usr/bin/schema-ctl" "$KG.new/" &&
        # -L: a symlinked svc would follow later edits instead of holding the set that booted
        cp -pRL "$R/etc/schema-init/services/." "$KG.new/services/" &&
        cp -p "$R/usr/libexec/schema-init/schema-pi-bootok" \
              "$R/usr/libexec/schema-init/schema-pi-deadline" "$KG.new/" &&
        point_at_kg; then
        # data must be on disk before the rename, or a power cut leaves truncated known-good files
        sync
        # without the guard a failed move-aside would nest .new inside $KG
        if [ ! -d "$KG" ] || mv "$KG" "$KG.old"; then
            if mv "$KG.new" "$KG"; then
                sync
                rm -rf "$KG.old"
                return 0
            fi
            # a failed swap must not leave the Pi with no known-good set
            [ ! -e "$KG" ] && [ -d "$KG.old" ] && mv "$KG.old" "$KG"
        fi
    fi
    echo "pi-bootok: known-good promotion failed" >&2
    rm -rf "$KG.new"
    return 1
}

# schema-pi enable seeds known-good through this; no boot wait, no state change
if [ "${1:-}" = --promote ]; then
    restore_old
    promote
    exit $?
fi

start=$(now)
last=
while :; do
    b=$(blockers)
    [ -z "$b" ] && break
    t=$(now)
    # elapsed seconds, not poll counts: POLL is overridable and may be fractional
    if [ -z "$last" ] || [ $((t - last)) -ge 60 ]; then
        echo "$b" | while read -r l; do echo "pi-bootok: waiting on $l"; done
        last=$t
    fi
    sleep "$POLL"
done

target=$(sed -n 's/^last_target=//p' "$STATE" 2>/dev/null | head -n 1)
case $target in
    current|known-good|systemd) ;;
    *) target=current ;;
esac

# the wrapper parses this strictly; tmp+mv keeps it whole across power loss
tmp=$STATE.tmp.$$
printf 'attempts=0\nlast_target=%s\n' "$target" > "$tmp"
sync
mv "$tmp" "$STATE"

mkdir -p "$R/run/schema-init"
: > "$MARK"

restore_old
[ "$target" = current ] && promote

echo "pi-bootok: boot confirmed after $(($(now) - start))s (target=$target)"
