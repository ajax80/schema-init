#!/bin/sh
# Mount /etc/fstab at boot, read live every time (mount-fstab.svc).
#
# Parents before children, a bind after its source; already-mounted targets
# skipped. Each device is waited for up to x-systemd.device-timeout= (default
# 90 s, nofail 10 s; 0 = no limit). noauto, _netdev, / and pseudo filesystems
# are skipped. Failures are logged and the run still exits 0: a non-zero
# oneshot is retried, and each retry would wait out the timeouts again while
# everything that depends on mount-fstab stays blocked.

FSTAB=${SCHEMA_FSTAB:-/etc/fstab}
CONSOLE=${SCHEMA_CONSOLE:-/dev/console}
PSEUDO='proc|sysfs|tmpfs|devtmpfs|devpts|cgroup|cgroup2|mqueue|hugetlbfs|debugfs|securityfs|configfs|fusectl|bpf|tracefs|pstore|efivarfs|ramfs|rpc_pipefs|binfmt_misc|autofs|overlay|squashfs'

log() { printf 'schema-mount-fstab: %s\n' "$*"; }

[ -r "$FSTAB" ] || { log "cannot read $FSTAB"; exit 1; }

has_opt() { case ",$1," in *",$2,"*) return 0 ;; esac; return 1; }

opt_val() {
    printf '%s' "$1" | tr ',' '\n' | sed -n "s/^$2=//p" | tail -1
}

# systemd timespan ("90", "1.5s", "1min30s", "500ms", "2h") -> whole seconds,
# rounded up; empty if unparseable.
timeout_secs() {
    printf '%s' "$1" | awk '
        BEGIN { u["us"]=1e-6; u["usec"]=1e-6; u["ms"]=0.001; u["msec"]=0.001
                u[""]=1; u["s"]=1; u["sec"]=1; u["second"]=1; u["seconds"]=1
                u["m"]=60; u["min"]=60; u["minute"]=60; u["minutes"]=60
                u["h"]=3600; u["hr"]=3600; u["hour"]=3600; u["hours"]=3600
                u["d"]=86400; u["day"]=86400; u["days"]=86400 }
        {
            s=$0; t=0
            if (s == "") exit
            if (s == "infinity") { print 0; exit }
            while (s != "") {
                if (!match(s, /^[0-9]+(\.[0-9]+)?/)) exit
                n=substr(s, 1, RLENGTH) + 0; s=substr(s, RLENGTH + 1)
                match(s, /^[a-z]*/); unit=substr(s, 1, RLENGTH); s=substr(s, RLENGTH + 1)
                if (!(unit in u)) exit
                t += n * u[unit]
            }
            r=int(t); if (r < t) r++
            print r
        }'
}

clean_opts() {
    o=$(printf '%s' "$1" | tr ',' '\n' \
        | grep -viE '^(x-.*|nofail|noauto|auto|_netdev|defaults|comment=.*)$' \
        | paste -sd, -)
    printf '%s' "${o:-defaults}"
}

# Block device for a spec, empty until it exists.
resolve() {
    case "$1" in
        UUID=*|LABEL=*|PARTUUID=*|PARTLABEL=*)
            blkid -l -o device -t "$1" 2>/dev/null ;;
        /dev/*)
            [ -b "$1" ] && printf '%s' "$1" ;;
        *)
            printf '%s' "$1" ;;
    esac
}

wait_dev() {
    spec=$1 limit=$2 waited=0
    while :; do
        dev=$(resolve "$spec")
        [ -n "$dev" ] && { printf '%s' "$dev"; return 0; }
        [ "$limit" -ne 0 ] && [ "$waited" -ge $((limit * 10)) ] && return 1
        sleep 0.1
        waited=$((waited + 1))
    done
}

# A multi-device btrfs mounts only once the kernel knows every member, which
# udev's 64-btrfs.rules arranges during coldplug; this may run before that.
btrfs_wait() {
    command -v btrfs >/dev/null || return 0
    if has_opt "$3" degraded; then btrfs device scan >/dev/null 2>&1; return 0; fi
    end=$(($(date +%s) + $2))
    while :; do
        btrfs device scan >/dev/null 2>&1
        btrfs device ready "$1" >/dev/null 2>&1 && return 0
        [ "$2" -ne 0 ] && [ "$(date +%s)" -ge $end ] && return 1
        sleep 0.2
    done
}

fsck_mode=auto
[ -e /forcefsck ] && fsck_mode=force
[ -e /fastboot ] && fsck_mode=skip
for w in $(cat "${SCHEMA_CMDLINE:-/proc/cmdline}" 2>/dev/null); do
    case "$w" in
        forcefsck|fsck.mode=force) fsck_mode=force ;;
        fastboot|fsck.mode=skip) fsck_mode=skip ;;
    esac
done

rescue() {
    log "$1"
    plymouth --wait quit 2>/dev/null
    printf '\n*** schema-mount-fstab: %s ***\nRepair it (fsck %s), then exit the shell to continue booting.\n\n' "$1" "$2" > "$CONSOLE"
    if command -v sulogin >/dev/null; then sh=sulogin; else sh=/bin/sh; fi
    setsid -w -c "$sh" < "$CONSOLE" > "$CONSOLE" 2>&1
    log "rescue shell exited"
}

fat_clean() {
    set -- $(od -v -An -tu1 -N72 "$1" 2>/dev/null) "$1"
    [ $# = 73 ] || return 1
    fdev=${73} bps=$((${12} + ${13} * 256)) rsvd=$((${15} + ${16} * 256))
    if [ $((${23} + ${24})) = 0 ]; then fflag=${66} fsig=${67} fw=4 fmask=12; else fflag=${38} fsig=${39} fw=2 fmask=192; fi
    [ "$bps" -gt 0 ] && [ "$fsig" = 41 ] && [ $((fflag & 3)) = 0 ] || return 1
    fhb=
    for x in $(od -v -An -tu1 -j$((bps * rsvd + fw)) -N$fw "$fdev" 2>/dev/null); do fhb=$x; done
    [ -n "$fhb" ] && [ $((fhb & fmask)) = $fmask ]
}

check() {
    cdev=$1 ctgt=$2 cfs=$3
    [ "$fsck_mode" = skip ] && return 0
    [ "$cfs" = auto ] && cfs=$(blkid -o value -s TYPE "$cdev" 2>/dev/null)
    command -v "fsck.$cfs" >/dev/null || { log "$ctgt: no fsck.$cfs, not checked"; return 0; }
    case "$cfs" in vfat|fat|msdos)
        [ "$fsck_mode" = auto ] && fat_clean "$cdev" && { log "$ctgt: $cdev was unmounted cleanly, not checked"; return 0; } ;;
    esac
    f=; [ "$fsck_mode" = force ] && f=-f
    out=$(fsck -a -T $f -t "$cfs" "$cdev" 2>&1); rc=$?
    [ -z "$out" ] || printf '%s\n' "$out" | sed "s|^|schema-mount-fstab: fsck $cdev: |"
    [ $rc -le 3 ] && { [ $rc = 0 ] || log "$ctgt: fsck fixed errors on $cdev ($rc)"; return 0; }
    [ $nofail = 1 ] && { fail "$ctgt: fsck $cdev failed ($rc), not mounted"; return 1; }
    rescue "$ctgt: fsck $cdev found errors it could not fix ($rc)" "$cdev"
    mounted "$ctgt" && { log "$ctgt mounted in the rescue shell"; return 1; }
    fsck -a -T $f -t "$cfs" "$cdev" >/dev/null 2>&1; rc=$?
    [ $rc -le 3 ] && { log "$ctgt: $cdev is clean now"; return 0; }
    fail "$ctgt: fsck $cdev still fails ($rc), not mounted"; return 1
}

mounted() { findmnt -rno TARGET --mountpoint "$1" >/dev/null 2>&1; }

failed=0

do_entry() {
    spec=$1 tgt=$2 fs=$3 opts=$4 fpass=$5
    nofail=0; has_opt "$opts" nofail && nofail=1
    raw=$(opt_val "$opts" x-systemd.device-timeout)
    t=""
    [ -z "$raw" ] || t=$(timeout_secs "$raw")
    [ -n "$raw" ] && [ -z "$t" ] && log "$tgt: x-systemd.device-timeout=$raw not understood, using the default"
    [ -n "$t" ] || { if [ $nofail = 1 ]; then t=10; else t=90; fi; }

    fail() {
        if [ $nofail = 1 ]; then log "$1 (nofail, continuing)"; else log "$1"; failed=1; fi
    }

    if [ "$fs" = swap ]; then
        dev=$(wait_dev "$spec" "$t") || { fail "swap $spec: no device after ${t}s"; return; }
        real=$(readlink -f "$dev")
        while read -r name _; do
            [ "$(readlink -f "$name" 2>/dev/null)" = "$real" ] && return
        done < /proc/swaps
        swapon "$dev" 2>&1 && log "swap $dev" || fail "swap $dev FAILED"
        return
    fi

    mounted "$tgt" && { log "$tgt already mounted"; return; }
    if has_opt "$opts" bind; then
        dev=$spec
    else
        dev=$(wait_dev "$spec" "$t") || { fail "$tgt: $spec not present after ${t}s"; return; }
        btype=$fs; [ "$fs" = auto ] && btype=$(blkid -o value -s TYPE "$dev" 2>/dev/null)
        if [ "$btype" = btrfs ]; then
            btrfs_wait "$dev" "$t" "$opts" || { fail "$tgt: btrfs on $dev: not all devices present after ${t}s"; return; }
        fi
        [ "${fpass:-0}" = 0 ] || [ "$fs" = none ] || check "$dev" "$tgt" "$fs" || return
    fi
    mkdir -p "$tgt"
    case "$fs" in auto|none) set -- ;; *) set -- -t "$fs" ;; esac
    if mount "$@" -o "$(clean_opts "$opts")" "$dev" "$tgt" 2>&1; then
        log "$tgt mounted ($spec)"
    else
        fail "$tgt mount FAILED ($spec)"
    fi
}

# parents first: kind<TAB>depth<TAB>spec<TAB>target<TAB>fstype<TAB>opts<TAB>fsck pass
rows=$(awk -v pseudo="$PSEUDO" '
    /^[[:space:]]*#/ || NF < 3 { next }
    {
        spec=$1; tgt=$2; fs=$3; opts=(NF >= 4 ? $4 : "defaults")
        if (fs ~ ("^(" pseudo ")$") || tgt == "/") next
        o="," opts ","
        if (o ~ /,noauto,/) next
        if (o ~ /,_netdev,/) { print "skip\t0\t" spec "\t" tgt "\t" fs "\t_netdev"; next }
        pass="m"
        depth=(fs == "swap") ? 0 : gsub(/\//, "/", tgt)
        if (o ~ /,bind,/) { src=spec; d=gsub(/\//, "/", src) + 1; if (d > depth) depth=d }
        print pass "\t" depth "\t" spec "\t" $2 "\t" fs "\t" opts "\t" (NF >= 6 ? $6 : 0)
    }' "$FSTAB" | sort -t "$(printf '\t')" -k2,2n)

tab=$(printf '\t')
while IFS=$tab read -r pass depth spec tgt fs opts fpass; do
    [ -n "$spec" ] || continue
    if [ "$pass" = skip ]; then log "$tgt skipped (_netdev: no network ordering here)"; continue; fi
    do_entry "$spec" "$tgt" "$fs" "$opts" "$fpass"
done <<EOF
$rows
EOF

rm -f /forcefsck /fastboot
[ $failed = 0 ] || { log "done, with failures"; exit 0; }
log "done"
