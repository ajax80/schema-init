#!/usr/bin/bash
set -euo pipefail

ENTRIES=/boot/loader/entries
GRUBENV=/boot/grub2/grubenv
KEEP="${SCHEMA_SNAP_KEEP:-3}"
PREFIX_SNAP=schema-snap
DEV=""
TOP=""

die() { echo "schema-snapshot: $*" >&2; exit 1; }

need_root() { [ "$(id -u)" = 0 ] || die "must run as root"; }
need_btrfs() { [ "$(findmnt -no FSTYPE /)" = btrfs ] || die "root filesystem is not btrfs"; }

resolve_dev() { DEV="$(findmnt -no SOURCE / | sed 's/\[.*//')"; [ -n "$DEV" ] || die "cannot resolve root device"; }

mount_top() { TOP="$(mktemp -d)"; mount -o subvolid=5 "$DEV" "$TOP"; }
umount_top() {
  [ -n "$TOP" ] || return 0
  umount "$TOP" 2>/dev/null || umount -l "$TOP" 2>/dev/null || true
  rmdir "$TOP" 2>/dev/null || true
  TOP=""
}
trap umount_top EXIT

info_field() { grubby --info=DEFAULT | sed -n "s/^$1=\"\\(.*\\)\"/\\1/p"; }

separate_boot() { findmnt -n /boot >/dev/null 2>&1; }

cmd_create() {
  local label="${1:-manual}"
  local ts base rootsnap homesnap homesub kbase ibase args rootdev newargs fstab title kdir initrd_line=""
  ts="$(date +%Y%m%d-%H%M%S)"
  base="$PREFIX_SNAP-$ts-$label"
  rootsnap="$base"
  homesnap="$base-home"
  kbase="$(basename "$(info_field kernel)")"
  ibase="$(info_field initrd | awk '{print $1}')"
  ibase="${ibase:+$(basename "$ibase")}"
  args="$(info_field args)"
  rootdev="$(info_field root)"
  [ -n "$kbase" ] && [ -n "$rootdev" ] || die "could not read default boot entry via grubby"

  mount_top
  [ -e "$TOP/$rootsnap" ] && { umount_top; die "$rootsnap already exists"; }
  btrfs subvolume snapshot / "$TOP/$rootsnap" >/dev/null
  btrfs subvolume snapshot /home "$TOP/$homesnap" >/dev/null
  fstab="$TOP/$rootsnap/etc/fstab"
  awk -v r="$rootsnap" -v h="$homesnap" '
    $2=="/"     && $3=="btrfs" { sub(/subvol=[^, ]+/, "subvol=" r) }
    $2=="/home" && $3=="btrfs" { sub(/subvol=[^, ]+/, "subvol=" h) }
    { print }' "$fstab" > "$fstab.new" && mv "$fstab.new" "$fstab"
  homesub="$(findmnt -no SOURCE /home | sed -n 's/.*\[\/\(.*\)\]$/\1/p')"
  if [ -n "$homesub" ]; then
    # no match (a clean install) is exit 1, which pipefail would turn into a silent abort
    { grep -rlE "subvol=/?$homesub([, ]|$)" "$TOP/$rootsnap/usr/local/bin" "$TOP/$rootsnap/etc/schema-init" 2>/dev/null || true; } |
      while read -r f; do sed -i -E "s#subvol=/?$homesub([, ]|$)#subvol=$homesnap\1#g" "$f"; done
  fi
  umount_top

  newargs="$(printf '%s' "$args" | sed "s/rootflags=subvol=[^ ]*/rootflags=subvol=$rootsnap/")"
  title="schema-init snapshot — $label ($ts)"
  if separate_boot; then
    mkdir -p "/boot/$base"
    cp "/boot/$kbase" "/boot/$base/"
    [ -z "$ibase" ] || cp "/boot/$ibase" "/boot/$base/"
    kdir="/$base"
  else
    kdir="/$rootsnap/boot"
  fi
  # no initrd line at all without one: grub's blscfg stops reading an entry
  # at a blank line, dropping options (no root=, kernel panic) — 11-18
  [ -z "$ibase" ] || initrd_line="initrd $kdir/$ibase
"
  {
    printf 'title %s\nversion %s\nlinux %s/%s\n%s' "$title" "${kbase#vmlinuz-}" "$kdir" "$kbase" "$initrd_line"
    printf 'options root=%s %s\ngrub_users $grub_users\ngrub_arg --unrestricted\ngrub_class fedora\n' "$rootdev" "$newargs"
  } > "$ENTRIES/$base.conf"
  echo "created: $rootsnap (+ $homesnap) -> $ENTRIES/$base.conf"
  cmd_prune
}

cmd_prune() {
  local snaps old n pinned
  # the armed guard boots schema_fallback_id on a failed boot; pruning it leaves
  # the guard pointing at nothing (11-21: create pruned post-bootfix, verify caught it)
  pinned="$(grub2-editenv "$GRUBENV" list 2>/dev/null | sed -n 's/^schema_fallback_id=//p')" || pinned=""
  mount_top
  mapfile -t snaps < <(ls -1 "$TOP" 2>/dev/null | grep -E "^$PREFIX_SNAP-[0-9]{8}-[0-9]{6}-" | grep -v -- '-home$' | grep -vxF -- "$pinned" | sort)
  umount_top
  n=${#snaps[@]}
  [ "$n" -gt "$KEEP" ] || return 0
  for old in "${snaps[@]:0:$((n-KEEP))}"; do
    mount_top
    btrfs subvolume delete "$TOP/$old" >/dev/null 2>&1 || true
    btrfs subvolume delete "$TOP/$old-home" >/dev/null 2>&1 || true
    umount_top
    rm -f "$ENTRIES/$old.conf"
    rm -rf "/boot/$old"
    echo "pruned: $old"
  done
}

cmd_delete() {
  local name="${1:?usage: schema-snapshot delete <name>}"
  case "$name" in "$PREFIX_SNAP-"*) ;; *) die "refusing to delete non-snapshot subvol: $name" ;; esac
  mount_top
  btrfs subvolume delete "$TOP/$name" >/dev/null 2>&1 || true
  btrfs subvolume delete "$TOP/$name-home" >/dev/null 2>&1 || true
  umount_top
  rm -f "$ENTRIES/$name.conf"
  rm -rf "/boot/$name"
  echo "deleted: $name"
}

cmd_list() {
  mount_top
  echo "== snapshots =="
  ls -1 "$TOP" 2>/dev/null | grep -E "^$PREFIX_SNAP-" || echo "(none)"
  umount_top
  echo "== boot entries =="
  ls -1 "$ENTRIES" 2>/dev/null | grep -E "^$PREFIX_SNAP-" || echo "(none)"
}

newest_fallback_id() {
  local id
  id="$(ls -1 "$ENTRIES" 2>/dev/null | grep -E "^$PREFIX_SNAP-[0-9]{8}-[0-9]{6}-.*\.conf$" | sort | tail -1)"
  [ -n "$id" ] || id="$(ls -1 "$ENTRIES" 2>/dev/null | grep -E '^schema-good.*\.conf$' | sort | tail -1)"
  printf '%s' "${id%.conf}"
}

esp_grubcfg_is_stub() {
  local esp mnt="" cfg rc=0
  esp="$(findmnt -n -o TARGET /boot/efi 2>/dev/null)"
  if [ -z "$esp" ]; then
    findmnt --fstab -n /boot/efi >/dev/null 2>&1 || return 0
    mnt="$(mktemp -d)"
    mount -o ro "$(findmnt --fstab -n -o SOURCE /boot/efi)" "$mnt" || { rmdir "$mnt"; die "cannot mount the ESP to check its grub.cfg"; }
    esp="$mnt"
  fi
  for cfg in "$esp"/EFI/*/grub.cfg; do
    [ -f "$cfg" ] || continue
    ! grep -q '^### BEGIN /etc/grub.d/00_header' "$cfg" || { echo "${cfg#"$esp"}"; rc=1; }
  done
  [ -z "$mnt" ] || { umount "$mnt"; rmdir "$mnt"; }
  return "$rc"
}

check_armable() {
  local bad
  grep -q 'schema_fallback_id' /boot/grub2/grub.cfg 2>/dev/null ||
    die "09_schema_fallback is not in /boot/grub2/grub.cfg; run 'make install-bootguard' and grub2-mkconfig -o /boot/grub2/grub.cfg"
  bad="$(esp_grubcfg_is_stub)" ||
    die "ESP$bad is a full GRUB config that loads its own grubenv, not $GRUBENV; replace it with a configfile stub to /boot/grub2"
  command -v schema-bootok >/dev/null && ls /etc/schema-init/services/schema-bootok.svc >/dev/null 2>&1 ||
    die "schema-bootok is not installed on the rail; an armed guard would roll back good boots"
}

cmd_arm() {
  local force=0 n=2 id rc=0 a
  for a in "$@"; do
    # a stray word would land in grubenv as boot_counter and break the guard's GRUB arithmetic
    case "$a" in --force) force=1 ;; ''|*[!0-9]*) die "usage: schema-snapshot arm [--force] [N]" ;; *) n="$a" ;; esac
  done
  # arming bets the next boot on this box coming back: verify first, as reboot does
  if [ "$force" = 0 ]; then
    schema-ctl verify --quiet --arming >&2 || rc=$?
    case "$rc" in
      0) ;;
      1) die "not armed — fix the above; 'schema-snapshot arm --force' to override" ;;
      2) die "not armed — fix the above or run 'schema-ctl verify --accept'; 'schema-snapshot arm --force' to override" ;;
      3) die "not armed — verification could not resolve the above; 'schema-snapshot arm --force' to override" ;;
      *) die "not armed — verification unavailable (schema-ctl verify exited $rc); 'schema-snapshot arm --force' to override" ;;
    esac
  fi
  check_armable
  id="$(newest_fallback_id)"
  [ -n "$id" ] || die "no snapshot boot entry to arm against; run 'schema-snapshot create' first"
  grub2-editenv "$GRUBENV" set schema_fallback_id="$id"
  grub2-editenv "$GRUBENV" set boot_counter="$n"
  grub2-editenv "$GRUBENV" set boot_success=0
  echo "armed: fallback=$id boot_counter=$n"
}

cmd_disarm() {
  grub2-editenv "$GRUBENV" unset boot_counter 2>/dev/null || true
  grub2-editenv "$GRUBENV" unset schema_fallback_id 2>/dev/null || true
  echo "disarmed"
}

need_root
need_btrfs
resolve_dev

case "${1:-}" in
  create) shift; cmd_create "${1:-manual}" ;;
  prune)  cmd_prune ;;
  delete) shift; cmd_delete "${1:-}" ;;
  list)   cmd_list ;;
  arm)    shift; cmd_arm "$@" ;;
  disarm) cmd_disarm ;;
  *) die "usage: schema-snapshot {create [label]|list|prune|delete <name>|arm [--force] [N]|disarm}" ;;
esac
