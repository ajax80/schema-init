#!/bin/bash
tck=$(getconf CLK_TCK)
since_boot() {
    local p; p=$(pgrep -o -f -- "$1" 2>/dev/null) || { echo "-"; return; }
    awk -v t="$tck" '{printf "%.2f", $22/t}' /proc/$p/stat
}
read -r up _ < /proc/uptime
mem_used=$(awk '/MemTotal/{t=$2}/MemAvailable/{a=$2}END{printf "%d", (t-a)/1024}' /proc/meminfo)
printf 'init=%s uptime=%.0f\n' "$(cat /proc/1/comm)" "$up"
printf 'nm=%s sshd=%s agetty_tty1=%s xorg=%s xfce4_session=%s xfdesktop=%s\n' \
    "$(since_boot '(^|/)NetworkManager( |$)')" "$(since_boot 'sshd.*listener')" "$(since_boot 'agetty.*tty1')" \
    "$(since_boot '(^|/)(Xorg|X)( |$)')" "$(since_boot '^xfce4-session( |$)')" "$(since_boot '^xfdesktop( |$)')"
printf 'mem_used_mb=%s procs=%s pid1_rss_kb=%s\n' "$mem_used" "$(ls -d /proc/[0-9]* | wc -l)" "$(awk '/VmRSS/{print $2}' /proc/1/status)"
rm=$(sudo dmesg | sed -n 's/^\[ *\([0-9.]*\)\] EXT4-fs ([a-z0-9]*): mounted filesystem .*/\1/p' | head -1)
xd=$(since_boot '^xfdesktop( |$)')
printf 'root_mounted=%s xfdesktop_after_root=%s\n' "$rm" "$(awk -v a="$xd" -v b="$rm" 'BEGIN{ if (a=="-") print "-"; else printf "%.2f", a-b}')"
