/* AirzDowne Solutions boot splash — Plymouth Script plugin */

/* White background */
Window.SetBackgroundTopColor(1.0, 1.0, 1.0);
Window.SetBackgroundBottomColor(1.0, 1.0, 1.0);

/* Load and center the logo */
logo.image   = Image("logo.png");
logo.sprite  = Sprite(logo.image);
logo.sprite.SetX(Window.GetWidth()  / 2 - logo.image.GetWidth()  / 2);
logo.sprite.SetY(Window.GetHeight() / 2 - logo.image.GetHeight() / 2);
logo.sprite.SetOpacity(1);

/* Subtle breathing pulse on the logo */
fun refresh_callback() {
    t = Plymouth.GetBootTime();
    opacity = 0.72 + 0.28 * Math.Sin(t * 1.8);
    logo.sprite.SetOpacity(opacity);
}
Plymouth.SetRefreshFunction(refresh_callback);
